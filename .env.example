# ─────────────────────────────────────────────────────────────────
#  Quran Reels Agent — Environment Variables
#  Copy this file to  .env  and fill in your real values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Instagram Graph API ───────────────────────────────────────────
# Get from: https://developers.facebook.com → your app → Instagram Basic Display
INSTAGRAM_ACCESS_TOKEN=your_long_lived_page_access_token_here
INSTAGRAM_BUSINESS_ID=your_instagram_business_account_id_here

# ── Optional: Public video URL (required by Graph API) ───────────
# If you host generated videos on S3 / Cloudflare R2 / similar, set this.
# The Graph API needs a public HTTPS URL to ingest the video.
# Leave empty to use the resumable upload flow instead.
VIDEO_PUBLIC_URL=

# ── Optional: Override reciter ────────────────────────────────────
# Reciter IDs: 7=Alafasy, 1=Al-Hussary, 3=Minshawi
# RECITER_ID=7
